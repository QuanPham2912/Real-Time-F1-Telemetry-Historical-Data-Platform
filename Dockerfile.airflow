FROM apache/airflow:3.3.1-python3.11
USER root
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /tmp/fastf1_cache /home/airflow/.ivy2 \
    && chown -R airflow:0 /tmp/fastf1_cache /home/airflow/.ivy2
USER airflow
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt apache-airflow-providers-fab